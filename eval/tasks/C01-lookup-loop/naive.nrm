;; The loop is right, but a failed lookup ends the run.
(define lookup-loop (model kb ctx fuel)
  (if (<= fuel 0)
      (fail 'out-of-fuel)
      (case (ask model Move ctx 'move)
        [(Lookup key)
           (lookup-loop model kb
                        (append ctx (list (Message [role Assistant] [content (show (Lookup key))])
                                          (Message [role Tool]      [content (call kb lookup key)])))
                        (- fuel 1))]
        [(Final answer) answer])))

(define investigate (model kb question fuel)
  (lookup-loop model kb (list (Message [role User] [content question])) fuel))
