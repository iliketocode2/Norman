;; Counts every occurrence of a number together, adjacent or not.
(define count-of (x xs)
  (length (filter (lambda (y) (= x y)) xs)))

(define without (x xs)
  (filter (lambda (y) (not (= x y))) xs))

(define run-length (xs)
  (case xs
    ['() '()]
    [(cons y ys) (cons (Pair [fst y] [snd (count-of y xs)]) (run-length (without y ys)))]))
