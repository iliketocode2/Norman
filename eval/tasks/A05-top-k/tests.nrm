(use interface.nrm)
(use solution.nrm)

(check-expect (top-k 3 (list 4 9 1 7 3)) (list 9 7 4))
(check-expect (top-k 2 (list 5 5 1)) (list 5 5))
(check-expect (top-k 5 (list 2 8)) (list 8 2))
(check-expect (top-k 0 (list 1 2 3)) '())
(check-expect (top-k -1 (list 1 2 3)) '())
(check-expect (top-k 2 '()) '())
(check-expect (top-k 3 (list -1 -5 -2 -9)) (list -1 -2 -5))
