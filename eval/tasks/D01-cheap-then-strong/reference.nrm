(define qa-ctx (question)
  (list (Message [role System] [content "Answer the question in a sentence or less."])
        (Message [role User]   [content question])))

(define answer (fast strong question)
  (catch (ask fast (Text 300) (qa-ctx question) 'fast) e
    (case e
      [(Invalid _) (ask strong (Text 300) (qa-ctx question) 'strong)]
      [(Refused _) (ask strong (Text 300) (qa-ctx question) 'strong)]
      [_           (fail e)])))
