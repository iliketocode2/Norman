(use interface.nrm)
(use solution.nrm)

(script two     [prices/quotes (result "[{\"vendor\":\"A\",\"cents\":500},{\"vendor\":\"B\",\"cents\":300}]") (latency 1s)])
(script tie     [prices/quotes (result "[{\"vendor\":\"A\",\"cents\":300},{\"vendor\":\"B\",\"cents\":300},{\"vendor\":\"C\",\"cents\":900}]") (latency 1s)])
(script none    [prices/quotes (result "[]") (latency 1s)])
(script glitch  [prices/quotes (result "<html>502</html>") (latency 1s)
                               (result "[{\"vendor\":\"A\",\"cents\":700}]") (latency 1s)])
(script broken  [prices/quotes (result "oops") (latency 1s)
                               (result "oops") (latency 1s)])
(script offline [prices/quotes (error "connection refused") (latency 1s)
                               (error "connection refused") (latency 1s)])

(under ([script two] [cost $1.00] [time 1min])
  (check-expect (cheapest prices "sku-1") (Some (Quote [vendor "B"] [cents 300]))))
(under ([script tie] [cost $1.00] [time 1min])
  (check-expect (cheapest prices "sku-1") (Some (Quote [vendor "A"] [cents 300]))))
(under ([script none] [cost $1.00] [time 1min])
  (check-expect (cheapest prices "sku-1") None))
(under ([script glitch] [cost $1.00] [time 1min])
  (check-expect (cheapest prices "sku-1") (Some (Quote [vendor "A"] [cents 700]))))
(under ([script broken] [cost $1.00] [time 1min])
  (check-fail (cheapest prices "sku-1") (Invalid _)))
(under ([script offline] [cost $1.00] [time 1min])
  (check-fail (cheapest prices "sku-1") (ToolError _)))
